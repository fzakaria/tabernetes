# The agent: the site, and the kubelet of every tab. The variables are
# written by setup.sh to /etc/tabernetes/env.
[Unit]
Description=tabernetes, the kubelet of a cluster whose nodes are browser tabs
After=k3s.service network-online.target
Wants=k3s.service network-online.target

[Service]
EnvironmentFile=/etc/tabernetes/env
# tabc keeps its images under the home directory's cache.
Environment=HOME=/root
ExecStartPre=/opt/tabernetes/deploy/firewall.sh
ExecStart=/opt/tabernetes/bin/tabernetes \
  --tabc /opt/tabernetes/bin/tabc \
  --share /opt/tabernetes/share \
  --cni-config /opt/tabernetes/deploy/tabs.json \
  --host-path-root /var/lib/tabernetes/data \
  --public-url ${PUBLIC_URL} \
  --max-nodes ${MAX_NODES} \
  --max-nodes-per-address ${MAX_NODES_PER_ADDRESS} \
  --unkernel-mirror ${UNKERNEL_MIRROR} \
  --geo-db /var/lib/tabernetes/geo/dbip-city-lite.mmdb \
  --zone ${ZONE} \
  --expose ${EXPOSE}
Restart=always
RestartSec=2
# Every pod is two tabc processes, each with a handful of files open.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
