# A resident: a headless browser on the cluster's own machine with the
# join page open, so that the cluster has nodes when nobody is
# visiting. setup.sh starts as many as RESIDENTS says, and the agent
# gives one up for each visitor who finds the cluster full.
[Unit]
Description=tabernetes resident %i, a headless browser that is a node
After=tabernetes.service
Wants=tabernetes.service

[Service]
# The residents' word, which the page says to the agent.
EnvironmentFile=/etc/tabernetes/env
# A user of the unit's own, with a directory for the browser's profile
# and nothing else of the machine to write to.
DynamicUser=yes
StateDirectory=tabernetes-resident-%i
Environment=HOME=%S/tabernetes-resident-%i
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# The browser's own sandbox needs user namespaces, which Ubuntu keeps
# from programs it has no profile for. The page is the cluster's own,
# and the unit's settings above are the fence.
ExecStart=/opt/chrome-headless-shell/current/chrome-headless-shell \
  --no-sandbox \
  --disable-gpu \
  --disable-dev-shm-usage \
  --user-data-dir=%S/tabernetes-resident-%i/profile \
  --remote-debugging-port=0 \
  http://127.0.0.1:8000/join#resident=${RESIDENT_WORD}
Restart=always
RestartSec=10
# A resident is the least important thing on the machine: visitors'
# pods and the control plane come first.
MemoryMax=700M
CPUWeight=20
Nice=10

[Install]
WantedBy=multi-user.target
